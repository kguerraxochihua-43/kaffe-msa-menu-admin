{
  "info": {
    "_postman_id": "d6f9b919-0000-4000-8000-menuadminv2",
    "name": "Kaffe MSA Menu Admin",
    "description": "CRUD administrativo de menus, categorias, productos, extras, grupos de extras y disponibilidad/asignacion por sucursal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "protocolProfileBehavior": {
    "disableCookies": true
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.remove('Cookie');",
          "pm.request.headers.remove('cookie');",
          "const token = pm.environment.get('token') || pm.globals.get('token') || pm.collectionVariables.get('token');",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health text",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "auth": { "type": "noauth" }
          },
          "response": []
        },
        {
          "name": "Health JSON",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/health/json",
              "host": ["{{baseUrl}}"],
              "path": ["health", "json"]
            },
            "auth": { "type": "noauth" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Menus",
      "item": [
        {
          "name": "List menus",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/menu-admin/cafeterias/{{cafeteriaId}}/menus",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu-admin", "cafeterias", "{{cafeteriaId}}", "menus"]
            }
          },
          "response": []
        },
        {
          "name": "Create global menu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.menuId) pm.environment.set('menuId', json.data.menuId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Menu Principal\",\n  \"description\": \"Menu base disponible para todas las sucursales.\",\n  \"global\": true,\n  \"active\": true,\n  \"sortOrder\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu-admin/cafeterias/{{cafeteriaId}}/menus",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu-admin", "cafeterias", "{{cafeteriaId}}", "menus"]
            }
          },
          "response": []
        },
